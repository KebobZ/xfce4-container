[Unit]
Description=TigerVNC display :1 for the XFCE desktop (loopback only)

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStartPre=-/usr/bin/rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
ExecStart=/usr/bin/Xtigervnc :1 -geometry 1920x1200 -depth 24 -localhost -rfbport 5901 -SecurityTypes None -AlwaysShared -desktop xfce
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
