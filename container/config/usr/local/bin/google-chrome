#!/bin/sh
# Every launch path (PATH, menus, dock, xdg-open) goes through this wrapper. Chrome's
# sandbox needs unprivileged user namespaces, which host/allow-userns.sh enables on the
# host. The "unsupported command-line flag" banner is off by the managed policy in
# /etc/opt/chrome/policies/managed/desktop.json.
exec /opt/google/chrome/google-chrome \
  --disable-dev-shm-usage \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  "$@"
